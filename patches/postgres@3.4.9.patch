diff --git a/cjs/src/connection.js b/cjs/src/connection.js
index 07f6716702ac888215c86ad6e0071aaf55ae519c..e3bea0657330b73923332297b89aad89af00d4da 100644
--- a/cjs/src/connection.js
+++ b/cjs/src/connection.js
@@ -252,6 +252,10 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
   }
 
   function nextWrite(fn) {
+    // Deno(Supabase Edge)에서는 clearImmediate로 지운 예약이 그대로 불려, 직접 호출이
+    // chunk를 비운 뒤에 다시 들어오는 경우가 있다. null을 쓰면 잡히지 않는 예외로 워커가 죽으므로 건너뛴다.
+    if (chunk === null)
+      return true
     const x = socket.write(chunk, fn)
     nextWriteTimer !== null && clearImmediate(nextWriteTimer)
     chunk = nextWriteTimer = null
