# Supabase 프로젝트 주소와 anon(publishable) key. 브라우저에 노출되므로 service role key를 넣지 않는다.
# 로컬: `pnpm db:status -o env`의 API_URL, ANON_KEY (pnpm dev는 자동으로 넣는다)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Google 로그인 화면에서 고를 수 있는 계정 도메인(hd)과 도메인 거부 안내 문구에 쓴다.
VITE_ALLOWED_EMAIL_DOMAIN=kakaocorp.com

# API 주소(예: https://<project-ref>.supabase.co/functions/v1). 개발 서버에서 비우면 상대 경로(/api, Vite 프록시)를 쓰고, 운영 빌드에서 비우면 앱이 오류를 낸다.
VITE_API_BASE_URL=
