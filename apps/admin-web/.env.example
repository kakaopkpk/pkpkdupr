# Supabase 프로젝트 주소와 anon(publishable) key. 브라우저에 노출되므로 service role key를 넣지 않는다.
# 로컬: `pnpm db:status -o env`의 API_URL, ANON_KEY (pnpm dev는 자동으로 넣는다)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# API 주소(예: https://<project-ref>.supabase.co/functions/v1). 비우면 상대 경로(/api)를 쓴다(개발 서버 Vite 프록시).
VITE_API_BASE_URL=
