# Supabase 프로젝트 주소와 anon(publishable) key. 브라우저에 노출되므로 service role key를 넣지 않는다.
# 로컬: `pnpm db:status -o env`의 API_URL, ANON_KEY (pnpm dev는 자동으로 넣는다)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# API 주소(예: https://<project-ref>.supabase.co/functions/v1). 비우면 상대 경로(/api)를 쓴다(개발 서버 Vite 프록시).
VITE_API_BASE_URL=

# Edge Function 실행 리전 고정값(Supabase 프로젝트 DB 리전 코드, 예: ap-southeast-1). 함수를 DB와 같은 리전에서 실행해 DB 왕복 지연을 줄인다. 비우면 forceFunctionRegion 파라미터를 붙이지 않는다.
VITE_FUNCTION_REGION=
