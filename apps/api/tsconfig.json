{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": [
            "ES2020",
            "DOM"
        ],
        "outDir": "./dist",
        "rootDir": "../..",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "declaration": true,
        "paths": {
            "@pkpkdupr/shared/*": [
                "../../packages/shared/src/*"
            ],
            "@pkpkdupr/db": [
                "../../packages/db/src/index.ts"
            ]
        }
    },
    "include": [
        "src/**/*",
        "../../packages/shared/src/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}
